rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // All writes go through Cloud Functions (Admin SDK bypasses these rules).
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function uname()    { return request.auth.token.email.split('@')[0]; }
    function roleDoc()  { return /databases/$(db)/documents/roles/$(uname()); }
    function isMember() {
      return signedIn() && request.auth.token.managed == true
        && exists(roleDoc()) && get(roleDoc()).data.active == true;
    }
    function isAdmin()  { return isMember() && get(roleDoc()).data.role == 'admin'; }

    match /sheets/{name} { allow read: if isMember(); }
    match /roles/{k}     { allow read: if signedIn() && k == uname(); }
    match /audit/{id}    { allow read: if isAdmin(); }
    match /meta/owner    { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.username == uname(); }
    match /{document=**} { allow read, write: if false; }
  }
}
